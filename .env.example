APP_BASE_URL=http://192.168.0.136:5000
APP_TIMEZONE=Europe/London
PORT=5000
SCRAPER_INTERVAL_SECONDS=300
EMAIL_POLL_SECONDS=300
LOG_VERBOSE=false

# Gmail inbox
GMAIL_USER=
GMAIL_APP_PASS=

# Optional generic IMAP inbox
EMAIL_USER=
EMAIL_APP_PASS=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993

GOOGLE_SHEET_CSV_URL=
GOOGLE_SHEET_WEBHOOK_URL=
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
HEALTHCHECKS_PING_URL=

# Adaptive application browser agent. Train in fill-only mode first.
AUTOAPPLY_ENABLED=false
AUTOAPPLY_AUTO_SUBMIT=false
AUTOAPPLY_AUTOPILOT_ENABLED=false
AUTOAPPLY_AUTOPILOT_MIN_SCORE=82
AUTOAPPLY_DAILY_LIMIT=3
AUTOAPPLY_HEADLESS=true
AUTOAPPLY_MAX_STEPS=8
AUTOAPPLY_PAGE_TIMEOUT=30
CHROMIUM_BINARY=/usr/bin/chromium
