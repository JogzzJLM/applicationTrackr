# ─────────────────────────────────────────────────────────────────
# applicationTrackr — Environment Variables Reference
# Copy this file to .env and fill in your values for local dev.
# For Portainer: paste each KEY=VALUE into the stack Environment section.
# NEVER commit your real .env file to git.
# ─────────────────────────────────────────────────────────────────

# Gmail credentials (App Password — not your main Gmail password)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# Google Apps Script Webhook URL (from your spreadsheet)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Healthchecks.io ping URL (optional — for uptime monitoring)
HEALTHCHECKS_PING_URL=https://hc-ping.com/YOUR_UUID

# Port override (default: 5000)
PORT=5000
